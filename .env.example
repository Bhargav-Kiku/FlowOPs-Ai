# FlowOps AI Backend — Environment Variables
# Copy this file to .env and fill in the values before running.

# ── Groq ──────────────────────────────────────────────────────────────────────
# Your Groq API key (required). Never commit the real key to source control.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary Groq model used for all endpoints except /summary.
# Defaults to llama-3.3-70b-versatile if not set.
GROQ_MODEL=llama-3.3-70b-versatile

# Fast/small model used for /api/v1/summary (low-latency, lower cost).
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── Auth ───────────────────────────────────────────────────────────────────────
# Shared API key that ServiceNow sends in the x-flowops-api-key request header.
# Generate a strong random string (e.g. openssl rand -hex 32).
FLOWOPS_API_KEY=your_strong_shared_secret_here

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000

# Node environment (development | production).
NODE_ENV=development

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max requests per window per API key (in-memory).
RATE_LIMIT_MAX=100
# Rate-limit window in milliseconds (default: 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
