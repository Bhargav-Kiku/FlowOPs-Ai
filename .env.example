# FlowOps AI Backend — Environment Variables
# Copy this file to .env and fill in the values before running.

# ── Gemini API (Multi-Key Support) ──────────────────────────────────────────
# Comma-separated list of Gemini API keys for automatic load rotation & rate-limit failover
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Single key fallback (if GEMINI_API_KEYS is not set)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model used for all endpoints except /summary.
# Defaults to gemini-3.6-flash if not set.
GEMINI_MODEL=gemini-3.6-flash

# Fast/small model used for /api/v1/summary (low-latency, lower cost).
GEMINI_FAST_MODEL=gemini-3.6-flash

# ── Auth ───────────────────────────────────────────────────────────────────
# Shared API key that ServiceNow sends in the x-flowops-api-key request header.
# Generate a strong random string (e.g. openssl rand -hex 32).
FLOWOPS_API_KEY=your_strong_shared_secret_here

# ── Server ─────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000

# Node environment (development | production).
NODE_ENV=development

# ── Rate Limiting ──────────────────────────────────────────────────────────
# Max requests per window per API key (in-memory).
RATE_LIMIT_MAX=100
# Rate-limit window in milliseconds (default: 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
